{
  "branches": [
    "main",
    "master",
    {
      "name": "dev",
      "prerelease": "beta"
    },
    {
      "name": "beta",
      "prerelease": true
    }
  ],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "./gradlew :app:syncUpdateJson -PVERSION_NAME=${nextRelease.version} && ./gradlew assembleRelease -PVERSION_NAME=${nextRelease.version}"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "update.json"
        ],
        "message": "chore(release): update update.json to ${nextRelease.version} [skip ci]"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "app/build/outputs/apk/release/*.apk",
            "label": "AutoSms-v${nextRelease.version}.apk"
          }
        ]
      }
    ]
  ]
}
