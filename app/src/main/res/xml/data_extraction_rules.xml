<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules controlling cloud backup and device-to-device transfers.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude Room database and SQLite files containing customer PII and message logs -->
        <exclude domain="database" path="auto_sms_database" />
        <exclude domain="database" path="auto_sms_database-wal" />
        <exclude domain="database" path="auto_sms_database-shm" />
        <!-- Include preferences and app configurations -->
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Exclude Room database files from device transfer -->
        <exclude domain="database" path="auto_sms_database" />
        <exclude domain="database" path="auto_sms_database-wal" />
        <exclude domain="database" path="auto_sms_database-shm" />
        <!-- Include preferences -->
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
