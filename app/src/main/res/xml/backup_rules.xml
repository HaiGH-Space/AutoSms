<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules file for Android 11 and lower.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!-- Exclude database containing PII -->
    <exclude domain="database" path="auto_sms_database" />
    <exclude domain="database" path="auto_sms_database-wal" />
    <exclude domain="database" path="auto_sms_database-shm" />
    <!-- Include preferences -->
    <include domain="sharedpref" path="." />
</full-backup-content>
