<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.AutoSms" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/autosms_primary</item>
        <item name="colorPrimaryVariant">@color/autosms_primary_variant</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/autosms_secondary</item>
        <item name="colorSecondaryVariant">@color/autosms_secondary_variant</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/autosms_surface</item>
        <item name="android:navigationBarColor">@color/autosms_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <!-- Disable system Force Dark to prevent hardware color inversion on Xiaomi/Oppo/Samsung -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>
</resources>